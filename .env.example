# Copy to .env.local. Never commit real values.

# Crew: api (default, the judge's pick) | grokbot (real Grok Bots via webhooks)
CREW=api
# Store: memory locally, redis on Vercel
STORE=memory
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# xAI
XAI_API_KEY=
XAI_MODEL=grok-4.7

# Our public URL (Vercel), used for MCP links, webhooks and text links
PUBLIC_URL=http://localhost:3000
# Bearer token for /api/agent/* and /api/mcp (openssl rand -hex 24)
AFTERHOURS_AGENT_TOKEN=

# Grok Bot crew: one routine webhook per Bot (from the routine's Webhook section)
GROKBOT_WEBHOOK_ROSA=
GROKBOT_KEY_ROSA=
GROKBOT_WEBHOOK_VIC=
GROKBOT_KEY_VIC=
GROKBOT_WEBHOOK_JUNE=
GROKBOT_KEY_JUNE=
GROKBOT_WEBHOOK_OTTO=
GROKBOT_KEY_OTTO=
GROKBOT_WEBHOOK_FERN=
GROKBOT_KEY_FERN=
GROKBOT_WEBHOOK_LOU=
GROKBOT_KEY_LOU=

# Texting: telegram (today) | imessage (Sendblue) | off
TEXT_CHANNEL=telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
SENDBLUE_API_KEY_ID=
SENDBLUE_API_SECRET=
SENDBLUE_FROM=
# Comma-separated E.164 numbers or Telegram chat ids allowed to receive texts
TEXT_ALLOWLIST=
# true: owners who pressed Start on our Telegram link can be texted without being in TEXT_ALLOWLIST (still only their own chat)
TEXT_ALLOW_SELF_LINKED=false

# Email (optional): only to these addresses
RESEND_API_KEY=
MAIL_FROM=
MAIL_ALLOWLIST=

# Vercel Cron (morning brief, P1)
CRON_SECRET=

# Frontend
NEXT_PUBLIC_CREW_SOURCE=api   # api | replay (replays a recorded real run from data/runs, labeled REPLAY)
